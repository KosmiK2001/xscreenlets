# Пример конфигурации инстанса disk_monitor.
# Секция = имя инстанса (его же имя файла без .conf в .plugins/).
# by_id — СТАБИЛЬНЫЙ путь /dev/disk/by-id на ЦЕЛЫЙ диск (без разделов, dm и md).
#
# ВАЖНО: не правьте живой конфиг скриптом через read().split('\n') +
# writelines() — строки теряют переводы строк, файл схлопывается в одну
# строку, демон не читает ни одного ключа, берёт дефолты и ПЕРЕЗАПИСЫВАЕТ
# конфиг целиком. Пишите байты через splitlines(keepends=True), сохраняйте
# переводы строк, сверяйте их количество до и после, и останавливайте демон:
# он сохраняет своё состояние при выходе.
[disk_monitor-1a2b3c4d-NVMe]
xs_type=disk_monitor
started_by=main_daemon
user_label=NVMe
by_id=/dev/disk/by-id/nvme-GRAVITON_SSD-256G3P4-M201_FSSD06814335_1
graph_label=NVMe 1 TB
# font — общий шрифт; ниже он же унаследуется в read/write/temp/label_font
# для старых экземпляров, у которых новых ключей ещё нет.
font=Sans 8
window_width=420
window_height=220
update_ms=1000

# Координаты — «проектные» пиксели для базового окна 420x220. При ресайзе
# dm_scale_position() пересчитывает их в live-пиксели, поэтому в конфиге их
# трогать при ресайзе не нужно.
read_x=10
read_y=4
write_x=100
write_y=4
temp_x=252
temp_y=4
label_x=130
label_y=4

# По умолчанию температурная линия скрыта; текущее значение температуры
# продолжает отображаться. Включается checkbox Temperature history.
show_temperature_history=false

# Скругление углов окна: 0 = прямые, максимум 200. Углы реально вырезаются
# из X-окна, сквозь них видно рабочий стол. Текст, заехавший в вырез, не
# рисуется — при желании сдвиньте координаты выше.
corner_radius=24

# Ключа background_color больше НЕТ: график занимает всё окно, отдельного
# базового слоя нет. Фон окна задаёт graph_background_color, и сквозь его
# прозрачность виден рабочий стол. Старый background_color игнорируется.
graph_background_color=0.020000,0.030000,0.050000,0.800000

# Пикеры фона графика и рамки — с настоящей шкалой прозрачности, alpha
# сохраняется как есть. Пикеры серий и текста — RGB-only, без шкалы.
border_color=0.550000,0.580000,0.620000,1.000000
text_color=1.000000,1.000000,1.000000,1.000000

# Цвет заливки серии отдельно от цвета её текста.
read_color=0.200000,0.750000,1.000000,1.000000
write_color=0.250000,0.850000,0.350000,1.000000
temp_color=1.000000,0.350000,0.120000,1.000000

# У каждой серии свой шрифт и свой цвет текста.
read_font=Sans 12
read_text_color=0.200000,0.750000,1.000000,1.000000
write_font=Sans 12
write_text_color=0.250000,0.850000,0.350000,1.000000
temp_font=Sans 14
temp_text_color=1.000000,0.350000,0.120000,1.000000
label_font=Ubuntu Mono Bold 14

x=80
y=80
opacity=1.0
