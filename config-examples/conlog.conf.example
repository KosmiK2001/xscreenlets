# Пример конфига апплета conlog — вывод команды.
# Скопируй в ~/.config/xscreenlets/.plugins/conlog-<id>-<имя>.conf
# и создай symlink с таким же именем в ~/.config/xscreenlets/plugins_on/

[conlog-c4d1a2b3-console]
type=conlog
xs_type=conlog

# Команда, вывод которой показывается. Запускается через /bin/sh -c:
# работают кавычки, перенаправление и переменные. При изменении в
# Настройках процесс перезапускается сразу.
command=journalctl -f -n 20

# Перезапуск команды по таймеру («как conky»):
# 0 (или ключ отсутствует) — команда запускается один раз, вывод
# читается до её завершения; живые фиды (journalctl -f, tail -f) при
# этом зависят от того, переживёт ли источник ротацию логов.
# N > 0 — каждые N секунд команда убивается целиком (вся процесс-группа),
# буфер очищается и запуск стартует заново: свежее переоткрытие файлов
# делает ротацию несущественной, а обрыв фида самоизлечивается следующим
# тиком. Для этого режима фид пишется БЕЗ -f: tail -n 24 /var/log/x.log
#refresh_interval=5

# Сколько строк хранить. Старые вытесняются по мере роста.
max_lines=200

# --- геометрия ---
# width_auto / height_auto: -1 = считать по содержимому,
# любое другое значение = использовать заданный размер вручную.
width_auto=-1
height_auto=-1
window_width=420
window_height=200
x=320
y=60
corner_radius=3
opacity=1.0

# --- текст ---
# Заголовок окна: метка пользователя в верхней зоне, под ней
# разделитель, и только потом строки журнала. Пустая строка — окно
# без заголовка, зона не резервируется.
title=

# line_step = 0 берёт шаг по фактической высоте шрифта; ненулевое
# значение увеличивает интервал (в пикселях).
row_font=Monospace 9
title_font=Monospace 9
first_row_y=6
line_step=14

# --- поведение ---
# Подсветка по уровню сообщения: error / warning / debug / info.
colorize=1
# Перенос длинных строк по ширине окна.
wrap=0
# Вырезать escape-последовательности (цвета ls, ip и systemctl).
strip_ansi=1
# Сохранять раскраску, которую команда прислала сама (ls --color,
# grep --color, вывод скрипта). Взаимоисключающе со strip_ansi.
keep_ansi=0
# Следовать за хвостом: при новых строках показывать конец журнала.
autoscroll=1

# --- цвета (rgba) ---
row_color=rgba(217,217,217,255)
title_color=rgba(217,217,217,255)
background_color=rgba(25,25,25,74)
border_color=rgba(115,115,115,255)
color_normal=rgba(217,217,217,255)
color_warn=rgba(255,204,77,255)
color_error=rgba(255,107,107,255)
color_info=rgba(140,217,255,255)
color_debug=rgba(158,158,179,255)
