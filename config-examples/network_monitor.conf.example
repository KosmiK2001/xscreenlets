# Сетевой applet: пример конфига.
# Копировать в ~/.config/xscreenlets/.plugins/<instance>.conf и создать
# симлинк с тем же именем в ~/.config/xscreenlets/plugins_on/.

[network_monitor-5a1c7f3d-wan0]
type=network_monitor

# Окно. График занимает всё окно (NM_GRAPH_TOP=0), подписи рисуются
# поверх него, поэтому отдельного места под них не резервируется.
window_width=420
window_height=110
corner_radius=8
opacity=1.0
x=0
y=4

# Как часто опрашивать /proc/net/dev.
update_ms=1000

# Сглаживание: 1 = мгновенная скорость, до 14 = среднее за N тиков.
rate_smooth=1

# Целевой интерфейс: физический (wan0), мост (brlan0), софт (tun10,
# fastvpn-*) или зеркало shaped-трафика (wan0_ifb). Имя, которого нет,
# не считается ошибкой: applet покажет N/A и дождётся интерфейса.
ifname=wan0

# --- График ---
# split   = два независимых поля рядом
# combined = одно поле, обе серии в нём
graph_mode=split

# Предел шкалы в КиБ/с, 0 = максимум наблюдённой истории.
# Шкала ОБЩАЯ для обеих серий: 11 Мбайт на графике выше, чем 100
# килобайт. Ручная константа держит высоту постоянной, когда трафик
# обычно ровный (как 95 для 100 Мбит в конфигах conky).
graph_max_kib=0

# --- Серии ---
# Подпись редактируется, положение переключается между «внутри
# графика» (метка и значение одной строкой) и «снаружи» (подпись над
# значением). Снаружи занимает отдельную строку, поэтому координаты
# разведены по вертикали: header y=2, подпись y=12, значение y=21.
series0_label=Down
series0_font=Sans 8
series0_x=8
series0_y=21
series0_label_x=8
series0_label_y=12
series0_placement=inside
series0_color=rgba(51,191,255,255)

series1_label=Up
series1_font=Sans 8
series1_x=218
series1_y=21
series1_label_x=218
series1_label_y=12
series1_placement=inside
series1_color=rgba(64,217,89,255)

# --- Оформление ---
# Цвета серий RGB-only: alpha у этой кнопки недоступен, иначе первое же
# сохранение обнуляло бы её. Настоящая прозрачность остаётся у фона
# графика и рамки.
text_color=rgba(255,255,255,255)
graph_background_color=rgba(5,8,13,255)
border_color=rgba(140,148,158,255)
label_font=Sans 8

# Строка «интерфейс: IP» сверху. Если адреса нет (ifb, tun) —
# показывается только имя, без пустого двоеточия.
header_x=4
header_y=2

# Строка «Total: RX / TX» — накопленный трафик с момента загрузки.
total_x=4
total_y=96
