# Дефолтный конфиг network_monitor.
#
# Разложение: заголовок и IP сверху, подписи и значения скоростей
# внутри своего графика (каждая на своей высоте), сводки Total в нижней
# полосе, split-графики с общей шкалой.
#
# Внутри графика подпись и число — РАЗДЕЛЬНЫЕ элементы:
#   series<N>_label_x/y — где стоит «Down:» / «Up:»
#   series<N>_x/y       — где стоит само число скорости
# Двигаются независимо. Значение не наезжает на подпись, если свести их
# координаты близко: минимальный зазор NM_VALUE_GAP.
#
# Снаружи (top/bottom) у элемента настраивается только X: положение по
# вертикали задаёт сама полоса. Внутри — X и Y.
[network_monitor-5a1c7f3d-wan0]
type=network_monitor
window_width=300
window_height=140
corner_radius=8
opacity=1.0
x=103
y=34
update_ms=1000
rate_smooth=1
graph_mode=split
graph_max_kib=0
# ifname=wan0   # выбери свой интерфейс: ip -br link
font=Sans 8
label_font=Sans 8
rx_label=Down
tx_label=Up
series0_font=Sans 8
series0_x=34
series0_y=10
series0_label_x=6
series0_label_y=23
series0_placement=inside
series1_font=Sans 8
series1_x=184
series1_y=26
series1_label_x=156
series1_label_y=23
series1_placement=inside
# Цвета принимаются в двух форматах:
#   rgba(r,g,b,a) и rgb(r,g,b) — значения 0..255, как пишет GtkColorButton;
#   0.2,0.75,1.0,1.0            — значения 0..1, в этом виде ключ
#                                переписывает сам диалог.
# Оба работают одновременно. Цвет серии берётся из series<N>_color;
# rx_color и tx_color читаются только если series<N>_color отсутствует
# (старые конфиги, где серии назывались по направлению).
series0_color=rgba(51,191,255,255)
series1_color=rgba(64,217,89,255)
# Цвет текста серии (подпись, число скорости, сводка). Если ключа нет —
# берётся цвет заливки, как раньше. Можно сделать подписи белыми, оставив
# заливку цветной.
#series0_text_color=rgba(255,255,255,255)
#series1_text_color=rgba(255,255,255,255)
# А можно и ещё мельче: свой цвет у подписи «Down:» и свой у числа.
# Оба по умолчанию берут series<N>_text_color.
#series0_label_color=rgba(255,220,0,255)
#series0_value_color=rgba(255,255,255,255)
#series1_label_color=rgba(255,220,0,255)
#series1_value_color=rgba(255,255,255,255)
# Цвета шапки. Имя интерфейса слева, адрес прижат вправо — у каждого свой
# цвет. По умолчанию оба берут text_color.
#header_ifname_color=rgba(220,220,220,255)
#header_ip_color=rgba(150,150,150,255)
text_color=rgba(255,255,255,255)
graph_background_color=rgba(5,8,13,255)
border_color=rgba(140,148,158,255)
header_x=8
header_y=40
xs_type=network_monitor
total0_label=Total down: %s
total1_label=Total up: %s
total0_font=Sans 8
total1_font=Sans 8
total0_x=8
total0_y=0
total1_x=159
total1_y=0
window_radius=8
header_placement=top
total0_placement=bottom
total1_placement=bottom
series0_label=Down:
series1_label=Up:

# Про зазор между подписью и числом.
#
# Подпись («Down:») при Sans 8 шириной около 22 px. Если series<N>_label_x
# и series<N>_x сведены так, что подпись кончается правее начала числа,
# подпись уезжает вправо за число — так число сохраняет свою
# координату, а оно уступать не должно. Чтобы подпись осталась СЛЕВА от
# числа, оставляйте между концом подписи и началом числа хотя бы 6-8 px:
#   series0_label_x=6, ширина 22 -> конец на 28
#   series0_x=34                  -> начало числа на 34, зазор 6
#
# Это не ограничение, а разумное требование: свести координаты
# настолько, что места между элементами не остаётся, нельзя.
